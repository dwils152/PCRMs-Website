# Apache settings for when this directory is the document root (see README).
# Security headers are sent by includes/bootstrap.php; HTTPS and HSTS belong
# in the server configuration.

ErrorDocument 404 /404.php

# No directory listings (data/, motifs_version/ and so on). data/ may be a
# link to the download files on another disk, so follow links whose owner
# matches their target (this also lets the rewrite rules below run). The
# server configuration must allow this with
# AllowOverride ... Options=Indexes,SymLinksIfOwnerMatch (see DEPLOYMENT.md).
Options -Indexes +SymLinksIfOwnerMatch

# Never serve dotfiles such as this one.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Downloads are gzip files, not compressed pages: serve them as they are, so
# browsers save the .gz file instead of unpacking it.
<IfModule mod_mime.c>
    RemoveEncoding .gz
    AddType application/gzip .gz
</IfModule>

# Under construction: uncomment the four lines below to show
# under-construction.html for every address while the site is set up.
# Visitors get status 503 (temporarily unavailable), which tells search
# engines to come back later. If the site lives in a subfolder, add it to the
# ErrorDocument path, for example /pcrms/under-construction.html.
#ErrorDocument 503 /under-construction.html
#RewriteEngine On
#RewriteCond %{REQUEST_URI} !/under-construction\.html$
#RewriteRule ^ - [R=503,L]
